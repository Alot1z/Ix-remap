---
// Copyright 2026 Ix Infrastructure Inc.

// Replaces Starlight's SiteTitle with ix-infra.com's wordmark: the paper-plane
// logo and a bold, tightly set "Ix", followed by a quieter "Docs" so the header
// says which site this is without competing with the brand.
import logo from '../assets/logo-dark.png';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="Ix Docs home" translate="no">
	<img src={logo.src} width={logo.width} height={logo.height} alt="" />
	<span class="wordmark">Ix</span>
	<span class="section">Docs</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		text-decoration: none;
		white-space: nowrap;
		transition: filter 200ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}
	.site-title:hover {
		filter: drop-shadow(0 0 10px rgba(91, 143, 212, 0.24));
	}
	img {
		width: 30px;
		height: 30px;
		object-fit: contain;
	}
	/* The ix-infra.com nav wordmark, at the docs header's height. */
	.wordmark {
		color: #e4e1de;
		font-size: 26px;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.04em;
	}
	.section {
		margin-left: 10px;
		padding-left: 12px;
		border-left: 1px solid rgba(147, 207, 255, 0.22);
		color: rgba(228, 225, 222, 0.68);
		font-size: 17px;
		font-weight: 500;
		line-height: 22px;
		letter-spacing: -0.01em;
	}
</style>
